# Owner: D
# ---- runtime LLM gateway (app/llm.py, A) ----
MOCK_LLM=false
LLM_PROVIDER=ollama
# "cloud" adds Groq then Gemini behind Ollama (only if keys are set)
LLM_FALLBACK=cloud
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GROQ_API_KEY=
# A's default; swap for a current free model from console.groq.com
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
# A's default; swap for a current free Flash model from aistudio.google.com
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- data generation (scripts/gen_*.py, C) ----
# true: deterministic content, no API calls
GEN_MOCK=false
GEN_LLM_ORDER=groq,gemini,ollama

# ---- retrieval (app/embeddings.py, app/retrieval.py, C) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBEDDER=hash               # tests/CI only: no model download

# ---- paths (defaults shown) ----
# DB_PATH=data/insightdesk.db
# CHROMA_DIR=data/chroma
