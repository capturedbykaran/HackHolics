# Owner: D
# ---- runtime LLM gateway (app/llm.py, A) ----
MOCK_LLM=false
LLM_PROVIDER=ollama
# "cloud" adds Groq then Gemini behind Ollama (only if keys are set)
LLM_FALLBACK=cloud
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GROQ_API_KEY=
# best on the 2026-10-06 fact-check test (see eval notes); other options: openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
# tested 2026-10-06: passes the KB fact check with thinking off; gemini-3.8-flash was overloaded (503)
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- data generation (scripts/gen_*.py, C) ----
# true: deterministic content, no API calls
GEN_MOCK=false
GEN_LLM_ORDER=groq,gemini

# ---- retrieval (app/embeddings.py, app/retrieval.py, C) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBEDDER=hash               # tests/CI only: no model download

# ---- paths (defaults shown) ----
# DB_PATH=data/insightdesk.db
# CHROMA_DIR=data/chroma

# ---- token budgets (free tiers) ----
# hidden reasoning tokens count against Groq's 1,000 output tokens/min; '' = model default
GROQ_REASONING_EFFORT=none
# Gemini thinking off for runtime JSON calls (~4x fewer tokens)
GEMINI_THINKING_BUDGET=0
# same for the generators (OpenAI-compatible endpoint)
GEMINI_REASONING_EFFORT=none
# free-tier budgets the generators pace themselves against
GROQ_OTPM=1000
GROQ_TPM=8000
GEMINI_RPM=10
